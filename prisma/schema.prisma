// StockPilot AI — Prisma Schema Definition
// Multi-Tenant Inventory Management SaaS Foundation

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Organization-level authorization roles.
enum OrganizationRole {
  OWNER
  MEMBER
}

/// Core Organization entity representing an isolated multi-tenant business account.
model Organization {
  id          String                   @id @default(uuid())
  name        String
  slug        String                   @unique
  status      String                   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  memberships OrganizationMembership[]

  @@index([slug])
  @@map("organizations")
}

/// Account status enum values: ACTIVE | SUSPENDED | INACTIVE
model User {
  id            String                   @id @default(uuid())
  name          String
  email         String                   @unique
  passwordHash  String                   @map("password_hash")
  status        String                   @default("ACTIVE")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  memberships   OrganizationMembership[]

  @@index([email])
  @@map("users")
}

/// Maps authenticated users to organizations with explicit authorization roles.
model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Persistent refresh token model for rotating secure session management.
/// Stores only SHA-256 cryptographic hashes of raw refresh tokens.
model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique @map("token_hash")
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId            String    @map("family_id")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}