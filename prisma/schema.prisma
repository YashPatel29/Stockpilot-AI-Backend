// StockPilot AI — Prisma Schema Definition
// Multi-Tenant Inventory Management SaaS Foundation

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Organization-level authorization roles.
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

/// Core Organization entity representing an isolated multi-tenant business account.
model Organization {
  id          String                   @id @default(uuid())
  name        String
  slug        String                   @unique
  status      String                   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  categories            ProductCategory[]
  products              Product[]
  warehouses            Warehouse[]
  storageLocations      StorageLocation[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderReceipts PurchaseOrderReceipt[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  demandForecastRuns    DemandForecastRun[]

  @@index([slug])
  @@map("organizations")
}

/// Account status enum values: ACTIVE | SUSPENDED | INACTIVE
model User {
  id              String                   @id @default(uuid())
  name            String
  email           String                   @unique
  passwordHash    String                   @map("password_hash")
  status          String                   @default("ACTIVE")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  refreshTokens          RefreshToken[]
  memberships            OrganizationMembership[]
  sentInvitations        OrganizationInvitation[] @relation("InvitedByUser")
  inventoryTransactions  InventoryTransaction[]
  createdPurchaseOrders  PurchaseOrder[]          @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders PurchaseOrder[]          @relation("ApprovedPurchaseOrders")
  purchaseOrderReceipts  PurchaseOrderReceipt[]   @relation("ReceivedPurchaseOrders")
  notifications          Notification[]
  auditLogs              AuditLog[]
  initiatedDemandForecasts DemandForecastRun[]

  @@index([email])
  @@map("users")
}

/// Maps authenticated users to organizations with explicit authorization roles.
model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Pending and historical invitations to join an organization with an assigned role.
/// Raw invitation tokens are NEVER stored; only cryptographic SHA-256 hashes are persisted.
model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique @map("token_hash")
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  revokedAt      DateTime?        @map("revoked_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([invitedById])
  @@map("organization_invitations")
}

/// Persistent refresh token model for rotating secure session management.
/// Stores only SHA-256 cryptographic hashes of raw refresh tokens.
model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique @map("token_hash")
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId            String    @map("family_id")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Lifecycle status for inventory products.
enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// Product categories within an organization for catalog classification.
model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("product_categories")
}

/// Inventory products owned by an organization, supporting SKU tracking, pricing, and status.
model Product {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  categoryId        String?       @map("category_id")
  sku               String
  name              String
  description       String?
  unitOfMeasure     String        @default("PCS") @map("unit_of_measure")
  costPrice         Decimal       @default(0) @map("cost_price") @db.Decimal(12, 4)
  sellingPrice      Decimal       @default(0) @map("selling_price") @db.Decimal(12, 4)
  lowStockThreshold Int           @default(0) @map("low_stock_threshold")
  status            ProductStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category              ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrderItems    PurchaseOrderItem[]
  demandForecastPoints  DemandForecastPoint[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, name])
  @@map("products")
}

/// Operational status for warehouses.
enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

/// Operational status for storage locations within warehouses.
enum LocationStatus {
  ACTIVE
  INACTIVE
}

/// Physical storage facility owned by an organization.
model Warehouse {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  code           String
  name           String
  description    String?
  addressLine1   String?         @map("address_line1")
  addressLine2   String?         @map("address_line2")
  city           String?
  state          String?
  postalCode     String?         @map("postal_code")
  country        String?
  status         WarehouseStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations             StorageLocation[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("warehouses")
}

/// Storage location within a warehouse (aisle, rack, shelf, bin).
model StorageLocation {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  warehouseId    String         @map("warehouse_id")
  code           String
  name           String
  description    String?
  type           String?
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse               Warehouse              @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inventoryBalances       InventoryBalance[]
  sourceTransactions      InventoryTransaction[] @relation("SourceLocationTransactions")
  destinationTransactions InventoryTransaction[] @relation("DestinationLocationTransactions")
  purchaseOrderReceipts   PurchaseOrderReceipt[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([organizationId])
  @@index([warehouseId, status])
  @@map("storage_locations")
}

/// Operation classification for inventory stock movements and adjustments.
enum InventoryTransactionType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER
}

/// Tracks current stock balance of a product at a specific storage location.
model InventoryBalance {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  warehouseId    String   @map("warehouse_id")
  locationId     String   @map("location_id")
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location     StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@map("inventory_balances")
}

/// Append-only audit ledger recording every inventory movement and stock adjustment.
model InventoryTransaction {
  id                    String                   @id @default(uuid())
  organizationId        String                   @map("organization_id")
  productId             String                   @map("product_id")
  warehouseId           String?                  @map("warehouse_id")
  type                  InventoryTransactionType
  quantity              Decimal                  @map("quantity") @db.Decimal(18, 4)
  quantityDelta         Decimal                  @map("quantity_delta") @db.Decimal(18, 4)
  sourceLocationId      String?                  @map("source_location_id")
  destinationLocationId String?                  @map("destination_location_id")
  reason                String?                  @map("reason")
  reference             String?                  @map("reference")
  notes                 String?                  @map("notes")
  idempotencyKey        String?                  @map("idempotency_key")
  requestHash           String?                  @map("request_hash")
  performedByUserId     String                   @map("performed_by_user_id")
  createdAt             DateTime                 @default(now()) @map("created_at")

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse           Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sourceLocation      StorageLocation? @relation("SourceLocationTransactions", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation StorageLocation? @relation("DestinationLocationTransactions", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  performedByUser     User             @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([organizationId, createdAt])
  @@index([type])
  @@index([organizationId, type])
  @@index([performedByUserId])
  @@map("inventory_transactions")
}

/// Supplier entity providing catalog items and inventory replenishment.
model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  email          String?
  phone          String?
  contactPerson  String?  @map("contact_person")
  address        String?
  taxIdentifier  String?  @map("tax_identifier")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("suppliers")
}

/// Lifecycle workflow status for purchase orders.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Purchase order tracking procurement commitments from suppliers.
model PurchaseOrder {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  supplierId           String              @map("supplier_id")
  orderNumber          String              @map("order_number")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  currency             String              @default("USD")
  subtotal             Decimal             @default(0) @db.Decimal(14, 4)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 4)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(14, 4)
  notes                String?
  createdByUserId      String              @map("created_by_user_id")
  approvedByUserId     String?             @map("approved_by_user_id")
  approvedAt           DateTime?           @map("approved_at")
  cancelledAt          DateTime?           @map("cancelled_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser  User                   @relation("CreatedPurchaseOrders", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUser User?                  @relation("ApprovedPurchaseOrders", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  items          PurchaseOrderItem[]
  receipts       PurchaseOrderReceipt[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@index([organizationId, orderDate])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@map("purchase_orders")
}

/// Line item within a purchase order specifying ordered and received product quantities.
model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  productId        String   @map("product_id")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(18, 4)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(18, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(14, 4)
  lineTotal        Decimal  @map("line_total") @db.Decimal(14, 4)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// Audit record for partial and complete delivery receipts against a purchase order.
model PurchaseOrderReceipt {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  purchaseOrderId  String   @map("purchase_order_id")
  locationId       String   @map("location_id")
  reference        String?  @map("reference")
  notes            String?  @map("notes")
  idempotencyKey   String?  @map("idempotency_key")
  requestHash      String?  @map("request_hash")
  receivedByUserId String   @map("received_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  location       StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedByUser User            @relation("ReceivedPurchaseOrders", fields: [receivedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([locationId])
  @@index([receivedByUserId])
  @@map("purchase_order_receipts")
}

/// Notification type enum distinguishing business and security event categories.
enum NotificationType {
  INFO
  WARNING
  PURCHASE_ORDER_SUBMITTED
  PURCHASE_ORDER_APPROVED
  PURCHASE_ORDER_RECEIVED
  PURCHASE_ORDER_CANCELLED
  LOW_STOCK_ALERT
  INVITATION_RECEIVED
  ROLE_UPDATED
  SECURITY_EVENT
}

/// User-scoped notification record for tracking business and system events.
model Notification {
  id              String           @id @default(uuid())
  organizationId  String?          @map("organization_id")
  recipientUserId String           @map("recipient_user_id")
  type            NotificationType @default(INFO)
  title           String
  message         String
  data            Json?
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientUser User          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

/// Append-only audit record capturing business mutations and security-relevant events.
model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  actorUserId    String?       @map("actor_user_id")
  action         String
  resourceType   String        @map("resource_type")
  resourceId     String?       @map("resource_id")
  metadata       Json?
  requestId      String?       @map("request_id")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, resourceType])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

/// Execution status of an organization-scoped demand forecast run.
enum ForecastRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  INSUFFICIENT_HISTORY
}

/// Historical or active demand forecast run metadata.
model DemandForecastRun {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  status            ForecastRunStatus @default(PENDING)
  modelName         String            @map("model_name")
  modelVersion      String            @map("model_version")
  horizonDays       Int               @map("horizon_days")
  lookbackDays      Int               @map("lookback_days")
  granularity       String            @default("DAILY")
  startedAt         DateTime?         @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  initiatedByUserId String?           @map("initiated_by_user_id")
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message")
  metadata          Json?             @map("metadata")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiatedByUser User?                 @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  points          DemandForecastPoint[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("demand_forecast_runs")
}

/// Time-series point prediction within a demand forecast run.
model DemandForecastPoint {
  id              String   @id @default(uuid())
  forecastRunId   String   @map("forecast_run_id")
  productId       String   @map("product_id")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  predictedDemand Decimal  @map("predicted_demand") @db.Decimal(18, 4)
  lowerBound      Decimal? @map("lower_bound") @db.Decimal(18, 4)
  upperBound      Decimal? @map("upper_bound") @db.Decimal(18, 4)
  unitOfMeasure   String   @map("unit_of_measure")
  createdAt       DateTime @default(now()) @map("created_at")

  forecastRun DemandForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([forecastRunId, productId, periodStart])
  @@index([forecastRunId])
  @@index([productId])
  @@index([periodStart])
  @@map("demand_forecast_points")
}



