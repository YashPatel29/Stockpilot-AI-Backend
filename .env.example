# ==============================================================================
# StockPilot AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Environment
# ------------------------------------------------------------------------------
# Execution mode: 'development' | 'test' | 'staging' | 'production'
# Required: YES
NODE_ENV=development

# Network port for HTTP server (e.g. 5000, 4000)
# Required: NO (defaults to 5000)
PORT=5000

# Network interface host binding ('0.0.0.0' for all interfaces, '127.0.0.1' for local loopback)
# Required: NO (defaults to 0.0.0.0)
HOST=0.0.0.0

# Structured log level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
# Required: NO (defaults to 'info')
LOG_LEVEL=info

# Reverse proxy trust level (e.g., 'true', 'false', 'loopback', or integer hop count)
# In production behind AWS ALB / Cloudflare / Nginx, set to 'true' or hop count
# Required: NO (defaults to false)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. API Routing & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Base API prefix path
# Required: NO (defaults to /api)
API_PREFIX=/api

# API semantic major version prefix
# Required: NO (defaults to v1)
API_VERSION=v1

# Allowlisted origins for CORS, comma-separated for multiple origins
# Example: http://localhost:3000,http://localhost:5173
# Required: YES in staging/production, defaults to local dev origins in development
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection URI
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Required: Required in staging/production; defaults to local dev URL in development
DATABASE_URL=postgresql://stockpilot_user:stockpilot_pass@localhost:5432/stockpilot_dev?schema=public

# Dedicated test database connection URI (used strictly for integration tests)
DATABASE_URL_TEST=postgresql://stockpilot_user:stockpilot_pass@localhost:5432/stockpilot_test?schema=public

# Connection pool settings (optional, documented in docs/DATABASE.md)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 4. Authentication, Sessions & Cookies
# ------------------------------------------------------------------------------
# Secret keys for signing access and refresh tokens (min 32 characters in production)
# Required: Required in staging/production
JWT_ACCESS_SECRET=replace_with_min_32_char_cryptographically_secure_random_key_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_min_32_char_cryptographically_secure_random_key
JWT_REFRESH_EXPIRES_IN=7d

# HttpOnly Cookie settings
# COOKIE_SECURE: Set to true in production (HTTPS required), false in local HTTP development
COOKIE_SECURE=false
# COOKIE_SAME_SITE: 'lax' | 'strict' | 'none'
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN: Optional domain restriction (e.g., .stockpilot.ai)
# COOKIE_DOMAIN=
# Max authentication attempts per IP per 15-minute window
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# 5. AI Copilot (LangChain & LangGraph Boundaries)
# ------------------------------------------------------------------------------
# AI Provider: 'none' | 'openai' | 'anthropic' | 'google' | 'mock'
# Server starts even when 'none' or no API key is provided
# Required: NO (defaults to 'none')
AI_PROVIDER=none

# Model identifier (e.g., gpt-4o, claude-3-5-sonnet-20241022, gemini-1.5-pro)
# Required: NO
AI_MODEL=gpt-4o

# API key for the selected AI provider
# Required: Only when AI_PROVIDER is active
AI_API_KEY=

# Maximum execution duration in milliseconds for an AI workflow execution
# Required: NO (defaults to 30000ms / 30s)
AI_REQUEST_TIMEOUT_MS=30000

# Maximum state-graph transition steps in LangGraph to prevent infinite loops
# Required: NO (defaults to 15)
AI_MAX_GRAPH_STEPS=15

# ------------------------------------------------------------------------------
# 6. Future Infrastructure (Redis & RabbitMQ)
# ------------------------------------------------------------------------------
# Redis connection URL for distributed caching and rate limiting
# Required: NO (optional until distributed queue/caching is enabled)
# REDIS_URL=redis://localhost:6379

# RabbitMQ AMQP connection URL for asynchronous inventory event processing
# Required: NO (optional until event bus is enabled)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

